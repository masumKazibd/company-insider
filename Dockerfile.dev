FROM node:22-alpine

WORKDIR /app

# Copy package files and install dependencies
COPY package.json package-lock.json ./
RUN npm ci

# Copy application source code
COPY . .

# Expose Angular dev server default port
EXPOSE 4200

# Start Angular dev server listening on 0.0.0.0 (native inotify watching)
CMD ["npm", "run", "start", "--", "--host", "0.0.0.0"]
